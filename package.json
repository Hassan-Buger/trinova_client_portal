{
  "name": "trinova-portal-frontend",
  "version": "1.0.0",
  "description": "Tailwind CSS build pipeline for TriNova Client Portal",
  "scripts": {
    "build:css": "npx tailwindcss -i ./public/assets/css/app.css -o ./public/assets/css/dist.css --minify",
    "watch:css": "npx tailwindcss -i ./public/assets/css/app.css -o ./public/assets/css/dist.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
